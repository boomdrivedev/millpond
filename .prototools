# The application tools, installed by proto and activated by the devenv
# shell: moon itself, and the Rust moon runs the crate's tasks with
# (.moon/toolchains.yml reads the rust pin). The system tools, proto among
# them, and the site's bun are devenv.nix's.
moon = "2.6.1"
# Rust's one pin, weir's: no other file names its version.
rust = "1.98.1"
